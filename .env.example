# Relay configuration.
#
# Copy this file to `.env` (`cp .env.example .env`) and edit it — Docker Compose reads
# `.env` automatically. Every variable below is consumed by docker-compose.yml; the values
# shown are the built-in defaults, so an unedited copy reproduces the local dev setup.
# Internal service URLs and ports are fixed in docker-compose.yml and are intentionally
# not exposed here. For a production checklist see docs/DEPLOYMENT.md.

# ─── Database (Postgres) ───────────────────────────────────────────────────────
# Change these for any real deployment. The API, backup sidecar and data layer all
# read the same three values, so you only set them once here.
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay

# ─── Object storage (MinIO / S3) ───────────────────────────────────────────────
# MinIO root credentials, also used as the API's S3 access/secret key. Change both
# for a real deployment (the bundled minioadmin/minioadmin is a dev default).
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ─── Internal services ─────────────────────────────────────────────────────────
# Shared secret authenticating internal, service-to-service calls (currently the gateway's
# per-channel voice-join authorization request to the API). The API and gateway must agree
# on this value. The built-in default is dev-only — set a long random string for any real
# deployment (e.g. `openssl rand -hex 32`).
INTERNAL_SERVICE_SECRET=relay-internal-dev-secret

# ─── Web client ────────────────────────────────────────────────────────────────
# HTTPS for the Vite dev server. true serves https://localhost:5173 with a self-signed
# cert (one-time "proceed anyway" in the browser) and gives LAN devices a secure context
# so mic/camera work. Set to false for plain HTTP (E2E, or TLS terminated by a proxy).
VITE_HTTPS=true

# Free GIPHY key for the GIF picker. Get one at https://developers.giphy.com
VITE_GIPHY_API_KEY=

# Allowed CORS origins for the API (comma-separated). Add your real client origin(s)
# when serving Relay from a domain other than localhost.
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:3000

# ─── Public URL & email ────────────────────────────────────────────────────────
# Public origin used to build links in emails (verification, password reset). Set this
# to your real address, e.g. https://relay.example.com.
PUBLIC_BASE_URL=http://localhost:5173

# Transactional email (SMTP). Leave SMTP_HOST empty to disable real sending — the API
# just logs the verification/reset URL instead (the self-hosted dev default). Fill these
# in to send real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender identity shown on outgoing verification / reset emails.
SMTP_FROM=Relay <no-reply@relay.local>
# SMTP_USE_TLS: implicit TLS/SMTPS, typically port 465.
SMTP_USE_TLS=false
# SMTP_STARTTLS: opportunistic STARTTLS upgrade, typically port 587.
SMTP_STARTTLS=true
# Send a "new login" notification email after each successful password login
# (only takes effect when SMTP_HOST is also set).
SMTP_LOGIN_NOTIFICATIONS=false

# ─── Voice (mediasoup / WebRTC) ────────────────────────────────────────────────
# Announced IP for media. Voice works out of the box for a browser on the SAME machine
# (localhost) with this left empty. To use voice from OTHER devices (a phone on your LAN,
# or over the internet), set this to the host's LAN or public IP so their browsers can
# send media to this server.
ANNOUNCED_IP=

# LAN/public-reachable voice-server signaling endpoint (host:port) advertised to clients.
# Defaults to 127.0.0.1:4001 (same machine only). Set it to <host-ip>:4001 for remote use.
VOICE_PUBLIC_ENDPOINT=127.0.0.1:4001

# ─── Seed & backups ────────────────────────────────────────────────────────────
# Demo accounts (owner/player1/player2) for local dev on a fresh database. OFF by default
# (fail closed) and never seeded with a password shipped in the repo. To enable them, set
# BOTH of the following. RELAY_DEMO_PASSWORD_HASH is an argon2id hash of the password you
# want the demo accounts to have — generate one after the stack is up with:
#   docker exec relay-api python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('choose-a-password'))"
# A real deployment should leave demo seeding off entirely.
RELAY_SEED_DEMO=false
RELAY_DEMO_PASSWORD_HASH=

# Database backups: how often the backup sidecar snapshots Postgres (seconds, default
# hourly) and how many snapshots to keep (default 48 ≈ 2 days of hourly backups).
BACKUP_INTERVAL=3600
BACKUP_KEEP=48
