# Database
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay
DATABASE_URL=postgresql+asyncpg://relay:relay@postgres:5432/relay

# Redis
REDIS_URL=redis://redis:6379/0

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# MinIO (S3-compatible)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev
S3_BUCKET=relay-attachments

# Services
GATEWAY_URL=ws://gateway:4000
DATA_SERVICES_URL=http://data-services:50051
API_URL=http://api:8000

# Public origin used to build links sent in emails (verification, password reset).
# Defaults to the local Vite dev server.
PUBLIC_BASE_URL=http://localhost:5173

# Transactional email (SMTP). Leave SMTP_HOST empty to disable real sending --
# the API will just log the verification/reset URL instead (self-hosted dev
# default, unchanged from before). Set these to send real emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender identity. shown on outgoing verification / reset emails.
SMTP_FROM=Relay <no-reply@relay.local>
# SMTP_USE_TLS: implicit TLS/SMTPS, typically port 465.
SMTP_USE_TLS=false
# SMTP_STARTTLS: opportunistic STARTTLS upgrade, typically port 587.
SMTP_STARTTLS=true
# Send a "new login" notification email after each successful password login.
# Only takes effect when SMTP_HOST is also set.
SMTP_LOGIN_NOTIFICATIONS=false

# Client
VITE_API_URL=http://localhost:8000/api/v10
VITE_GATEWAY_URL=ws://localhost:4000
VITE_CDN_URL=http://localhost:9000

# GIF picker (GIPHY). Get a free key at https://developers.giphy.com
VITE_GIPHY_API_KEY=

# Web client HTTPS (local dev). Serving over HTTPS gives a "secure context" so that
# mic/camera (getUserMedia) work from non-localhost devices. Uses a self-signed cert
# you accept once. Set to false for plain HTTP (localhost mic/camera still works).
VITE_HTTPS=true

# Voice (mediasoup / WebRTC) announced IP.
# Voice works out of the box for a browser on the SAME machine (localhost) with this
# left empty. To use voice from OTHER devices (a phone on your LAN, or over the
# internet), set this to the host's LAN IP or public IP so their browsers can send
# media to this server. The server always also offers loopback + its own addresses,
# so this is purely an additional candidate for remote reachability.
ANNOUNCED_IP=

# Seed the demo accounts (owner/player1/player2, shared dev password) on a fresh
# database. Set to false for a real deployment so no shared-password accounts exist.
RELAY_SEED_DEMO=true
