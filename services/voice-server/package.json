{
  "name": "@relay/voice-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": ["mediasoup", "esbuild"]
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "mediasoup": "^3.14.0",
    "ws": "^8.18.0",
    "uuid": "^10.0.0",
    "redis": "^4.7.0",
    "pino": "^9.5.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/ws": "^8.5.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "vitest": "^2.1.0",
    "eslint": "^9.0.0"
  }
}
